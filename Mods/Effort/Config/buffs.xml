<effort>

	<append xpath="/buffs">

		<buff name="buffHittingBlock" icon="server_favorite" icon_color="132,0,155" icon_blink="true"  hidden="true">
		
			<display_value_key value="Test  {0:0.0}%"/>
			<display_value value=".displayBlockHitCount"/>
			<duration value="0.1"/>
			<stack_type value="Replace"/>
	
			<effect_group>

				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".displayBlockHitCount" operation="set" value="0"/>

				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".displayBlockHitCount" operation="set" value="2">
									<requirement name="HoldingItemHasTags" tags="ranged" />
				</triggered_effect>


				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".displayBlockHitCount" operation="set" value="3">
					<requirement name="HoldingItemHasTags" tags="axe" />
					
				</triggered_effect>
				
				
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" target="self" buff="buffShowMiningProgression">
					<requirement name="HoldingItemHasTags" tags="light" />
					<requirement name="!HoldingItemHasTags" tags="motorTool" />
					<requirement name="RandomRoll" seed_type="Random" min_max="0,400" operation="LTE" value="2"/>
					<requirement name="PlayerLevel" operation="GTE" value="50"/>
					<requirement name="HoldingItemHasTags" tags="perkMiner69r" />
					
				</triggered_effect>
				
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" target="self" buff="buffShowMiningProgression">
					<requirement name="!HoldingItemHasTags" tags="light" />
					<requirement name="!HoldingItemHasTags" tags="motorTool" />
					<requirement name="RandomRoll" seed_type="Random" min_max="0,100" operation="LTE" value="2"/>
					<requirement name="PlayerLevel" operation="GTE" value="50"/>
					<requirement name="HoldingItemHasTags" tags="perkMiner69r" />
					
				</triggered_effect>
				
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" target="self" buff="buffShowMiningProgression">
					<requirement name="HoldingItemHasTags" tags="motorTool" />
					<requirement name="RandomRoll" seed_type="Random" min_max="0,600" operation="LTE" value="2"/>
					<requirement name="PlayerLevel" operation="GTE" value="50"/>
					<requirement name="HoldingItemHasTags" tags="perkMiner69r" />

					
				</triggered_effect>
				
			</effect_group>
		</buff>

		<!-- I have a bug here and I don't know how to fix it: the buff sometimes does not show up, only BeltTooltip appears, but it all works. Maybe this happens only on dedicated servers. -->
		<buff name="buffShowMiningProgression" icon="ui_game_symbol_perk" icon_color="132,0,155" icon_blink="true">
			<display_value_key value="Your Mining is increasing!"/>
			<display_value value="###"/>
			<duration value="3"/>
			<stack_type value="ignore"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="CallGameEvent" event="effort_action_show_mining_progression_BeltTooltip"/>
				<triggered_effect trigger="onSelfBuffStart" action="CallGameEvent" event="effort_action_increase_mining_progression"/>
			</effect_group>
		</buff>


	</append>

</effort>